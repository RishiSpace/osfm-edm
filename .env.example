# ── Server Core ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://osfm_edm:secret@localhost:5432/osfm_edm
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
SERVER_PORT=8080
AGENT_PORT=8443
SERVER_URL=https://localhost:8080
# Set to 1 only for local debugging without TLS.
ALLOW_INSECURE_HTTP=

# ── First-boot admin account (used only if no users exist in DB) ─────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately

# ── TLS (optional — if not set, server generates self-signed CA) ─────────────
TLS_CERT_PATH=
TLS_KEY_PATH=

# ── Notifications (all optional — configure the channels you want) ───────────
# SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=osfm-edm@yourdomain.com

# Webhook (POST JSON payload to this URL on alert)
WEBHOOK_URL=

# ntfy.sh push notifications (https://ntfy.sh)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ── Dashboard / CORS ─────────────────────────────────────────────────────────
# Browser origin of the Next.js UI (Access-Control-Allow-Origin).
CORS_ORIGIN=http://localhost:3000
# API URL the dashboard JavaScript calls (baked into the Next.js build).
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
